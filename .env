# Local placeholders for docker-compose.oxaide-workspace.yml.
# Keep real values in the deployment secret manager and never commit this file.
HERMES_OXAIDE_WORKSPACE_ID=replace-with-workspace-id
HERMES_OXAIDE_RUNTIME_KEY=replace-with-runtime-key
HERMES_OXAIDE_DEMO_AUTH_SECRET=replace-with-a-long-random-secret
HERMES_OXAIDE_USAGE_SIGNING_SECRET=replace-with-a-different-long-random-secret
HERMES_HOSTED_RUNTIME_SHARED_SECRET=replace-with-a-separate-long-random-secret
OXAIDE_RUNTIME_PORT=9119
OXAIDE_TURN_ENDPOINT=https://oxaide.com/api/agents/billing/usage/record
