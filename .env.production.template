# Oxaide hosted Agent runtime production template
# Copy to your secret manager or deployment environment. Do not commit real values.

# Core runtime
HERMES_HOSTED_RUNTIME_API_HOST=127.0.0.1
HERMES_HOSTED_RUNTIME_API_PORT=9001
HERMES_HOSTED_RUNTIME_SHARED_SECRET=__REQUIRED_SET_MATCHING_SHARED_SECRET__
HERMES_HOSTED_RUNTIME_TOKEN_ISSUER=hermes-webui
HERMES_HOSTED_RUNTIME_TOKEN_AUDIENCE=hermes-agent

# Persistent paths
HERMES_HOME=/srv/oxaide/hermes-home

# Notes
# - Keep this service private-only.
# - If WebUI and Agent run on separate machines, bind to a private interface only.
# - Do not expose this runtime on a public hostname.
# - The shared secret must match HERMES_WEBUI_AGENT_SHARED_SECRET exactly.