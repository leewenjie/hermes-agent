# Hermes Agent — Cloudflare Environment Template
# Copy to cloudflare/.env.cf and fill in values.
# NEVER commit .env.cf!

CF_ACCOUNT_ID=
HERMES_CF_CONNECTOR_URL=wss://hermes-gateway.yourdomain.workers.dev
AGENT_RUNTIME_TOKEN=
HERMES_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
HERMES_R2_ACCESS_KEY_ID=
HERMES_R2_SECRET_ACCESS_KEY=
HERMES_R2_BUCKET=hermes-skills
HERMES_R2_REGION=auto
RELAY_SHARED_SECRET=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_PUBLIC_KEY=
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=hermes_verify
SIGNAL_ACCOUNT=
SIGNAL_REST_URL=http://localhost:8080
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_ACCESS_TOKEN=
MATRIX_USER_ID=@hermes:matrix.org
CF_CONTAINER_CPU=2
CF_CONTAINER_MEMORY=4g
CF_IMAGE_NAME=hermes-agent:cf
SENTRY_DSN=
